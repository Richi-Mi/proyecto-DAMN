<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.respaldo.RespaldoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:src="@drawable/ic_cloud_upload"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/respaldo_intro"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            style="@style/Organizador.Etiqueta"
            android:layout_marginTop="24dp"
            android:text="@string/plataforma" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupo_plataforma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/plataforma_drive"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/plataforma_drive"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/google_drive"
                app:icon="@drawable/ic_cloud" />

            <Button
                android:id="@+id/plataforma_dropbox"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dropbox"
                app:icon="@drawable/ic_cloud" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/respaldo_ultimo"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    style="@style/Organizador.Dato"
                    app:drawableStartCompat="@drawable/ic_history"
                    android:text="@string/respaldo_ultimo_ejemplo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/respaldo_contenido"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    style="@style/Organizador.Dato"
                    app:drawableStartCompat="@drawable/ic_calendar"
                    android:text="@string/respaldo_contenido_eventos" />

                <TextView
                    style="@style/Organizador.Dato"
                    app:drawableStartCompat="@drawable/ic_label"
                    android:text="@string/respaldo_contenido_tipos" />

                <TextView
                    style="@style/Organizador.Dato"
                    app:drawableStartCompat="@drawable/ic_notifications"
                    android:text="@string/respaldo_contenido_config" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/boton_respaldar"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/realizar_respaldo"
            app:icon="@drawable/ic_cloud_upload" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/respaldo_nota"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
