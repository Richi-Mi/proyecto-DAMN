<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.restaurar.RestaurarFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:src="@drawable/ic_cloud_download"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/restaurar_intro"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            style="@style/Organizador.Etiqueta"
            android:layout_marginTop="24dp"
            android:text="@string/plataforma" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupo_plataforma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/plataforma_drive"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/plataforma_drive"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/google_drive"
                app:icon="@drawable/ic_cloud" />

            <Button
                android:id="@+id/plataforma_dropbox"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dropbox"
                app:icon="@drawable/ic_cloud" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/Organizador.Etiqueta"
            android:layout_marginTop="20dp"
            android:text="@string/restaurar_disponibles" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_respaldos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_respaldo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Aviso: restaurar reemplaza los datos locales -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorErrorContainer">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="12dp"
                app:drawableTint="?attr/colorOnErrorContainer"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/restaurar_aviso"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer"
                app:drawableStartCompat="@drawable/ic_warning" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/boton_restaurar"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/restaurar"
            app:icon="@drawable/ic_cloud_download" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
