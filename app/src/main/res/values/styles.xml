<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Título de cada sección dentro de un formulario -->
    <style name="Organizador.Etiqueta" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Etiqueta redondeada con el estatus del evento -->
    <style name="Organizador.Estatus" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_estatus</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Renglón de dato con ícono a la izquierda (fecha, contacto, ubicación...) -->
    <style name="Organizador.Dato" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Campo de texto que no se escribe: abre un selector (fecha, hora, mapa, contactos) -->
    <style name="Organizador.CampoSelector" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">true</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:inputType">none</item>
    </style>

    <style name="ThemeOverlay.Organizador.BarraSuperior" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/sobre_barra_superior</item>
        <item name="colorOnSurface">@color/sobre_barra_superior</item>
    </style>
</resources>
